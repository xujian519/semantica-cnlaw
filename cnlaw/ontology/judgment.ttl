@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix law:  <http://law> .
@prefix dec:  <https://cnlaw.dev/decision#> .
@prefix jg:   <https://cnlaw.dev/judgment#> .

<https://cnlaw.dev/judgment> a owl:Ontology ;
    rdfs:label "专利判决领域本体" ;
    rdfs:comment """Ontology for Chinese IP / patent court judgments (民事判决书 /
行政判决书 / 裁定书). These are court adjudication documents, distinct from the
administrative reexamination/invalidation decisions in decision.ttl. A judgment is
tied to the statute Articles it applies (jg:based_on -> law:Article) and to the
patent(s) it concerns (jg:involves -> dec:Patent, the same lightweight Patent node
the decisions connect to).""" ;
    owl:versionInfo "0.1.0-draft" ;
    dct:created "2026-08-25"^^xsd:date .

# ── Classes ──────────────────────────────────────────────────────────────────

jg:PatentJudgment a owl:Class ;
    rdfs:label "专利判决" ;
    rdfs:comment """A single court judgment on a patent / IP dispute. Carries the
case metadata (case number, court, dates, cause of action), the parties, the legal
provisions applied and the outcome.""" ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:Patent a owl:Class ;
    rdfs:label "专利" ;
    rdfs:comment "The patent involved in a judgment; shares the same node as dec:Patent." ;
    owl:equivalentClass dec:Patent ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

# ── Datatype properties ──────────────────────────────────────────────────────

jg:judgment_id a owl:DatatypeProperty ;
    rdfs:label "判决标识" ;
    rdfs:comment "The case number / document id for the judgment (always non-empty)." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:case_number a owl:DatatypeProperty ;
    rdfs:label "案号" ;
    rdfs:comment "Court case number, e.g. (2011)沪一中民五(知)初字第47号." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:case_type a owl:DatatypeProperty ;
    rdfs:label "案件类型" ;
    rdfs:comment "民事 / 行政 / 刑事 / 待核验 (derived from the cause of action or the document type)." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:cause a owl:DatatypeProperty ;
    rdfs:label "案由" ;
    rdfs:comment "The cause of action, e.g. 侵害发明专利权纠纷." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:court a owl:DatatypeProperty ;
    rdfs:label "审理法院" ;
    rdfs:comment "The court that rendered the judgment." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:decision_date a owl:DatatypeProperty ;
    rdfs:label "裁判日期" ;
    rdfs:comment "Date the judgment was issued, as an ISO date." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:invention_name a owl:DatatypeProperty ;
    rdfs:label "发明创造名称" ;
    rdfs:comment "Title of the invention/utility model/design at issue." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:patent_holder a owl:DatatypeProperty ;
    rdfs:label "专利权人" ;
    rdfs:comment "The patentee in the case." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:plaintiff a owl:DatatypeProperty ;
    rdfs:label "原告" ;
    rdfs:comment "The plaintiff / appellant / applicant in the case." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:defendant a owl:DatatypeProperty ;
    rdfs:label "被告" ;
    rdfs:comment "The defendant / appellee / respondent in the case." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:panel a owl:DatatypeProperty ;
    rdfs:label "合议庭" ;
    rdfs:comment "The collegial panel, as a display string (presiding judge + members)." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:legal_basis a owl:DatatypeProperty ;
    rdfs:label "法律依据" ;
    rdfs:comment "The statutory provisions applied, e.g. 专利法第十一条第一款." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:decision_points a owl:DatatypeProperty ;
    rdfs:label "裁判要点" ;
    rdfs:comment "The distilled legal holding / contested issue of the judgment." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:decision_result a owl:DatatypeProperty ;
    rdfs:label "判决结果" ;
    rdfs:comment "The outcome, e.g. 驳回上诉，维持原判 / 判令赔偿损失." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:claims a owl:DatatypeProperty ;
    rdfs:label "权利要求" ;
    rdfs:comment "The claims at issue, as raw text." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:legal_reasoning a owl:DatatypeProperty ;
    rdfs:label "说理" ;
    rdfs:comment "The court's reasoning narrative (本院认为), as raw text." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:application_number a owl:DatatypeProperty ;
    rdfs:label "申请号/专利号" ;
    rdfs:comment "The application / grant number of the primary patent at issue." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:full_text a owl:DatatypeProperty ;
    rdfs:label "判决全文" ;
    rdfs:comment "Cleaned judgment text used for document-level vectorization." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:source_path a owl:DatatypeProperty ;
    rdfs:label "源路径" ;
    rdfs:comment "Absolute source file path for provenance." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:source_file a owl:DatatypeProperty ;
    rdfs:label "源文件名" ;
    rdfs:comment "Source file name for provenance." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:domain a owl:DatatypeProperty ;
    rdfs:label "知识域" ;
    rdfs:comment "Knowledge domain tag, '专利判决' for this corpus." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

# ── Object properties ────────────────────────────────────────────────────────

jg:involves a owl:ObjectProperty ;
    rdfs:label "涉及专利" ;
    rdfs:comment "Links a PatentJudgment to the Patent (dec:Patent) it concerns." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range dec:Patent ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .

jg:based_on a owl:ObjectProperty ;
    rdfs:label "依据" ;
    rdfs:comment "Links a PatentJudgment to a statute Article (law:Article) it applies." ;
    rdfs:domain jg:PatentJudgment ;
    rdfs:range law:Article ;
    rdfs:isDefinedBy <https://cnlaw.dev/judgment> .
