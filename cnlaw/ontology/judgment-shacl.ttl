# SHACL constraints for the patent judgment corpus.
#
# These shapes turn judgment.ttl into a data-quality gate for the Neo4j import:
# a judgment must carry a non-empty judgment identifier, a case type and a
# domain tag; the involves edge must point at a Patent node (the shared node
# the decisions also connect to). Validated with PySHACL via an OntologyEngine.

@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix law: <https://cnlaw.dev/law#> .
@prefix dec: <https://cnlaw.dev/decision#> .
@prefix jg:  <https://cnlaw.dev/judgment#> .

jg:PatentJudgmentShape a sh:NodeShape ;
    sh:targetClass jg:PatentJudgment ;
    sh:property [
        sh:path jg:judgment_id ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "判决必须有判决标识 (judgment_id)" ;
    ] ;
    sh:property [
        sh:path jg:case_type ;
        sh:minCount 1 ;
        sh:in ( "民事" "行政" "刑事" "待核验" ) ;
        sh:message "case_type 必须是 民事/行政/刑事/待核验 之一" ;
    ] ;
    sh:property [
        sh:path jg:domain ;
        sh:minCount 1 ;
        sh:hasValue "专利判决" ;
        sh:message "domain 必须为 专利判决" ;
    ] ;
    sh:property [
        sh:path jg:decision_date ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:string ] ) ;
        sh:message "decision_date 必须是合法日期" ;
    ] ;
    sh:property [
        sh:path jg:involves ;
        sh:class dec:Patent ;
        sh:message "involves 指向的节点必须是 Patent" ;
    ] .

jg:PatentShape a sh:NodeShape ;
    sh:targetClass jg:Patent ;
    sh:property [
        sh:path dec:patent_number ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "专利节点必须有专利号 (patent_number)" ;
    ] .
